# Bu dosyayi .env olarak kopyalayin. .env git'e girmez.
# En az 32 karakter: openssl rand -base64 48
JWT_KEY=
# Bos birakilirsa sahte odeme saglayicisi devreye girer (yerel demo icin yeterli)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Yalnizca iyzico ile gerekli; ngrok adresi her yeniden baslatmada degisir
PAYMENT_CALLBACK_URL=
# Fake | Iyzico (bos: anahtar varsa Iyzico, yoksa Fake)
PAYMENT_PROVIDER=
# Frontend'in yayinlanacagi yerel port
FRONTEND_PORT=5173
